# Secrets para Streamlit Cloud
# Configure em: https://share.streamlit.io/ → App settings → Secrets

# ====================================
# 🤖 AI & LLM
# ====================================
GEMINI_API_KEY = "sua-chave-aqui"

# ====================================
# 💾 Database (Redis)
# ====================================
UPSTASH_REDIS_REST_URL = "https://sua-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN = "seu-token"

# ====================================
# 📅 Google Calendar (Opcional)
# ====================================
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""
GOOGLE_REDIRECT_URI = "http://localhost:8501"

# ====================================
# 🔍 Qdrant (Opcional)
# ====================================
QDRANT_URL = ""
QDRANT_API_KEY = ""

# ====================================
# 📧 Email (Opcional)
# ====================================
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = ""
SMTP_PASSWORD = ""
FROM_EMAIL = ""
NOTIFICATION_EMAILS = ""
