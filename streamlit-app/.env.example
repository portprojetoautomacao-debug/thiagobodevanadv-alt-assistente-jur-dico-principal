# ============================================
# ASSISTENTE JURÍDICO PJE - STREAMLIT VERSION
# ============================================

# API do Backend React (Vercel)
REACT_API_URL=https://assistente-juridico-github.vercel.app/api
REACT_API_KEY=your-api-key-here

# Upstash Redis (compartilhado com React)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Google Gemini
GEMINI_API_KEY=your-gemini-key-here

# OpenAI (alternativo)
OPENAI_API_KEY=your-openai-key-here

# Qdrant Vector DB (compartilhado)
QDRANT_URL=https://your-qdrant.cloud:6333
QDRANT_API_KEY=your-qdrant-key-here
QDRANT_COLLECTION=legal_docs

# DSPy Bridge (compartilhado)
DSPY_URL=http://localhost:8765
DSPY_API_TOKEN=your-token-here

# Heavy Processor (compartilhado)
HEAVY_PROCESSOR_URL=http://localhost:8080
HEAVY_PROCESSOR_API_KEY=your-key-here

# Selenium WebDriver
SELENIUM_HEADLESS=true
SELENIUM_TIMEOUT=30

# PyAutoGUI
PYAUTOGUI_FAILSAFE=true
PYAUTOGUI_PAUSE=0.5

# DJEN Scraping
DJEN_URL=https://www2.stf.jus.br/portalStfInternacional/cms/verConteudo.php?sigla=portalDjenDivulgacao
DJEN_CHECK_INTERVAL=3600  # 1 hora

# Sentry (monitoring)
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=development

# App Config
APP_TITLE=Assistente Jurídico PJe - Python Edition
APP_ICON=⚖️
APP_LAYOUT=wide
DEBUG=true
