# ===================================
# API Keys
# ===================================

# Google Gemini API (obrigatório)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API (opcional - para fallback)
OPENAI_API_KEY=your_openai_api_key_here

# ===================================
# LangSmith (Observabilidade)
# ===================================

# LangSmith API Key
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_key_here

# LangSmith Project
LANGCHAIN_PROJECT=assistente-juridico-prod

# Enable Tracing
LANGCHAIN_TRACING_V2=true
ENABLE_LANGSMITH=true

# LangSmith Endpoint (opcional)
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ===================================
# Cache (Redis/Upstash)
# ===================================

# Enable Redis Cache
ENABLE_REDIS_CACHE=false

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Enable Upstash Chat History
ENABLE_UPSTASH_CHAT_HISTORY=false

# ===================================
# Rate Limiting
# ===================================

# Gemini Rate Limits
GEMINI_MAX_REQ=10
GEMINI_WINDOW_SEC=60
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=6.5
GEMINI_MAX_RETRY_ATTEMPTS=5
GEMINI_RETRY_BASE_SECONDS=6

# ===================================
# Circuit Breaker
# ===================================

CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=60

# ===================================
# Batch Processing
# ===================================

BATCH_MAX_CONCURRENCY=5

# ===================================
# Memory
# ===================================

MEMORY_TTL=3600
ENABLE_MEMORY_SUMMARY=false

# ===================================
# Backend API
# ===================================

REACT_API_URL=http://localhost:8000
REACT_API_KEY=your_api_key_here

# ===================================
# Database & Storage
# ===================================

# Qdrant Vector Database
QDRANT_URL=your_qdrant_url
QDRANT_API_KEY=your_qdrant_key
QDRANT_COLLECTION=legal_docs

# ===================================
# Application Config
# ===================================

APP_TITLE=Assistente Jurídico PJe
APP_ICON=⚖️
APP_LAYOUT=wide
DEBUG=false

# ===================================
# Selenium & Automation
# ===================================

SELENIUM_HEADLESS=true
SELENIUM_TIMEOUT=30

PYAUTOGUI_FAILSAFE=true
PYAUTOGUI_PAUSE=0.5

# ===================================
# DJEN (Diário Eletrônico)
# ===================================

DJEN_URL=https://djen.tjrj.jus.br
DJEN_CHECK_INTERVAL=3600

# ===================================
# Monitoring (Sentry)
# ===================================

SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=development
