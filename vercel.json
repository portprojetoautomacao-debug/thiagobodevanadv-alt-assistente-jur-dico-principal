{
  "version": 2,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://assistente-jurdico-p.vercel.app/:path*",
      "permanent": true
    }
  ],
  "env": [
    "GEMINI_API_KEY",
    "TODOIST_TOKEN",
    "DJEN_API_KEY",
    "EVOLUTION_API_KEY",
    "EVOLUTION_INSTANCE_ID",
    "EVOLUTION_API_URL"
  ]
}
