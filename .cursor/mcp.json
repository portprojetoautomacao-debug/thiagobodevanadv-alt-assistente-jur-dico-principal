{
  "mcpServers": {
    "todoist": {
      "command": "/usr/local/share/nvm/versions/node/v22.21.1/bin/npx",
      "args": ["-y", "mcp-remote", "https://ai.todoist.net/mcp"],
      "env": {
        "PATH": "/usr/local/share/nvm/versions/node/v22.21.1/bin:${PATH}"
      }
    },
    "sonarqube": {
      "command": "/usr/local/share/nvm/versions/node/v22.21.1/bin/npx",
      "args": ["-y", "@modelcontextprotocol/server-sonarqube"],
      "env": {
        "PATH": "/usr/local/share/nvm/versions/node/v22.21.1/bin:${PATH}",
        "SONARQUBE_URL": "https://sonarcloud.io",
        "SONARQUBE_TOKEN": "${SONARQUBE_TOKEN}",
        "SONARQUBE_ORGANIZATION": "thiagobodevan-a11y-assistente-juridico-p"
      }
    }
  }
}
