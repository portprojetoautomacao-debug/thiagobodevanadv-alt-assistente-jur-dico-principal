{
  // === GitHub Copilot - Aprovação Automática ===
  "github.copilot.chat.agent.autoApprove": true,

  "files.watcherExclude": {
    "**/docs/archive/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.vercel/**": true,
    "**/coverage/**": true,
    "**/build/**": true,
    "**/.next/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.git": true,
    "**/.vercel": true,
    "**/.next": true,
    "**/coverage": true
  },
  "typescript.tsserver.maxTsServerMemory": 2048,
  "editor.stickyScroll.enabled": true,
  "gitlab.instanceUrl": "https://gitlab.com",
  "gitlab.pipelineGitRemoteName": "gitlab",
  "gitlab.showPipelineUpdateNotifications": true,
  "gitlab.showStatusBarLinks": true,
  "gitlab.showIssueLinkOnStatusBar": false,
  "gitlab.showMrStatusOnStatusBar": true,
  "gitlab.remoteName": "gitlab",
  "gitlab.debug": false,
  "workbench.editor.defaultBinaryEditor": "vscode.hexEditor",
  "node-module-intellisense.scanBuiltinModules": true,
  "node-module-intellisense.scanDevDependencies": true,
  "node-module-intellisense.scanFileModules": true,
  "node-module-intellisense.modulePaths": [],
  "node-module-intellisense.fileModuleExtensions": [
    ".js",
    ".jsx",
    ".ts",
    ".d.ts",
    ".tsx",
    ".vue",
    ".json"
  ],
  "search-node-modules.path": "node_modules",
  "search-node-modules.useLastFolder": false,

  // --- Configurações Tailwind CSS IntelliSense (v4 + shadcn/ui) ---
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["clsx\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],
  "editor.quickSuggestions": {
    "strings": true
  },
  "css.validate": false,
  "files.associations": {
    "*.css": "tailwindcss"
  },

  // === SonarLint Configuration ===
  // Path to Node.js executable (required for JS/TS analysis)
  "sonarlint.pathToNodeExecutable": "/usr/bin/node",
  
  // Connected Mode - bind to SonarCloud project
  "sonarlint.connectedMode.project": {

    "connectionId": "thiagobodevan-a11y",
    "projectKey": "thiagobodevan-a11y_assistente-juridico-p"
  },
  
  // SonarCloud connection (alternative to sonarqube)
  "sonarlint.connectedMode.connections.sonarcloud": [
    {
      "connectionId": "thiagobodevan-a11y",
      "organizationKey": "thiagobodevan-a11y",
      "token": "e04da699455ce47ef8caa0cced5d7b9c29c058d0"
    }
  ],

  // Path to Java runtime (required for SonarLint Language Server)
  "sonarlint.ls.javaHome": "/usr/lib/jvm/java-21-openjdk",
  "editor.defaultFormatter": "SonarSource.sonarlint-vscode",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "files.autoSave": "onFocusChange",
  "editor.codeActions.triggerOnFocusChange": true,
  "editor.codeActionsOnSave": {

  },
  "editor.experimentalGpuAcceleration": "on",
  "editor.pasteAs.preferences": [

  ],
  "diffEditor.codeLens": true,
  "editor.suggest.shareSuggestSelections": false
}
