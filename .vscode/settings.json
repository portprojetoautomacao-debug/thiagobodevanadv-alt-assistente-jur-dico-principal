{
  "files.watcherExclude": {
    "**/docs/archive/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true
  },
  "typescript.tsserver.maxTsServerMemory": 4096,
  "editor.stickyScroll.enabled": true,
  "gitlab.instanceUrl": "https://gitlab.com",
  "gitlab.pipelineGitRemoteName": "gitlab",
  "gitlab.showPipelineUpdateNotifications": true,
  "gitlab.showStatusBarLinks": true,
  "gitlab.showIssueLinkOnStatusBar": false,
  "gitlab.showMrStatusOnStatusBar": true,
  "gitlab.remoteName": "gitlab",
  "gitlab.debug": false,
  "workbench.editor.defaultBinaryEditor": "vscode.hexEditor",
  
  // Aprovação automática de comandos no terminal do Copilot
  "chat.tools.terminal.autoApprove": {
    // Git - todos os comandos
    "git": true,
    
    // GitHub CLI
    "gh": true,
    
    // NPM/Node
    "npm": true,
    "npx": true,
    "node": true,
    
    // Vercel
    "vercel": true,
    
    // Python
    "python": true,
    "python3": true,
    "pip": true,
    "pip3": true,
    
    // Docker
    "docker": true,
    "docker-compose": true,
    
    // Comandos de sistema comuns
    "cd": true,
    "ls": true,
    "cat": true,
    "mv": true,
    "cp": true,
    "rm": true,
    "mkdir": true,
    "touch": true,
    "echo": true,
    "sed": true,
    "grep": true,
    "find": true,
    "head": true,
    "tail": true,
    "tree": true,
    "pwd": true,
    "which": true,
    "chmod": true,
    "chown": true,
    "curl": true,
    "wget": true,
    "sleep": true,
    "clear": true,
    
    // Scripts do projeto
    "./": true,
    "bash": true,
    "sh": true
  }
}
