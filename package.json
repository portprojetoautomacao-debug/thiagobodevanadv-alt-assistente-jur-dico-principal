{
  "name": "assistente-juridico-p",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:with-api": "node ./scripts/start-dev-with-api.cjs",
    "dev:local": "node ./scripts/start-dev.cjs",
    "kill": "fuser -k 5000/tcp",
    "build": "vite build",
    "build:with-typecheck": "tsc && vite build",
    "type-check": "tsc --noEmit --skipLibCheck",
    "start": "serve -s dist -l 10000",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 eslint 'src/**/*.{ts,tsx}' 'api/**/*.ts' --ext ts,tsx --report-unused-disable-directives --max-warnings 150 --ignore-pattern 'coverage-api/**'",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=4096 eslint 'src/**/*.{ts,tsx}' 'api/**/*.ts' --ext ts,tsx --fix --ignore-pattern 'coverage-api/**'",
    "lint:sarif": "eslint 'src/**/*.{ts,tsx}' 'api/**/*.ts' --format @microsoft/eslint-formatter-sarif --output-file eslint-results.sarif --ignore-pattern 'coverage-api/**'",
    "tsc:sarif": "bash -lc \"npx --no-install @microsoft/tsc-sarif --out tsc-results.sarif 2>/dev/null || node ./scripts/tsc-to-sarif.cjs || true\"",
    "test:sarif": "bash -lc \"(npx --no-install vitest-sarif-reporter --out vitest-results.sarif 2>/dev/null) || (vitest run --reporter json > vitest-results.json || true && node ./scripts/vitest-to-sarif.cjs || true)\"",
    "optimize": "vite optimize",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "NODE_OPTIONS='--max-old-space-size=8192 --expose-gc' vitest run --no-coverage",
    "test:run:safe": "bash scripts/test-runner-with-lock.sh npm run test:run",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=8192 --expose-gc' vitest run --config vitest.config.node.ts --coverage",
    "test:shard": "NODE_OPTIONS='--max-old-space-size=8192 --expose-gc' vitest run --no-coverage --reporter=verbose",
    "test:fast": "NODE_OPTIONS='--max-old-space-size=4096 --expose-gc' vitest run src/test-smoke.test.ts src/**/*.{test,spec}.{ts,tsx} --run --reporter=dot",
    "test:watch:auto": "vitest --watch --reporter=verbose --no-coverage",
    "test:api": "NODE_OPTIONS='--max-old-space-size=8192 --expose-gc' vitest run --config vitest.config.node.ts",
    "test:api:safe": "bash scripts/test-runner-with-lock.sh npm run test:api",
    "test:chrome": "cd chrome-extension-pje && npm test",
    "test:all": "npm run test:run && npm run test:api && npm run test:chrome",
    "test:all:safe": "bash scripts/test-runner-with-lock.sh bash -c 'npm run test:run && npm run test:api'",
    "test:integration": "vitest run tests/integration/hybrid-agents.test.ts",
    "test:integration:local-real": "RUN_LOCAL_REAL_TESTS=1 vitest run --config vitest.config.node.ts api/tests/extension-errors.local-e2e.test.ts",
    "check:coverage": "bash scripts/check-coverage.sh",
    "activate:langgraph": "bash scripts/activate-langgraph-agents.sh",
    "test:e2e": "bash scripts/cleanup-test-ports.sh && playwright test --project=chromium",
    "test:e2e:headed": "bash scripts/cleanup-test-ports.sh && xvfb-run playwright test --headed --project=chromium",
    "test:e2e:debug": "bash scripts/cleanup-test-ports.sh && xvfb-run playwright test --headed --debug --project=chromium",
    "test:e2e:all": "bash scripts/cleanup-test-ports.sh && playwright test",
    "test:e2e:ui": "xvfb-run playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:auto": "./run-e2e-tests.sh",
    "test:real-local": "bash scripts/run-local-real-tests.sh",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "qdrant:populate-datajud": "node --loader ts-node/esm scripts/populate-qdrant-datajud.ts",
    "qdrant:init": "node --loader ts-node/esm scripts/init-qdrant-collection.ts",
    "qdrant:test": "node --loader ts-node/esm scripts/test-qdrant.ts",
    "qdrant:populate:dry-run": "node --loader ts-node/esm scripts/populate-qdrant-datajud.ts --dry-run --validate --max-docs=50",
    "sonar:local": "node sonar-run.mjs",
    "sonar:local:old": "node sonar-scanner.mjs",
    "sonar:local:esm": "node --experimental-loader node:module ./sonar-scanner.mjs",
    "check:sarif-tools": "node ./scripts/check-sarif-tools.cjs",
    "ensure:sarif-deps": "node ./scripts/ensure-official-sarif-deps.cjs",
    "ensure:sarif-deps:apply": "node ./scripts/ensure-official-sarif-deps.cjs --apply",
    "ensure:sarif-deps:apply:commit": "node ./scripts/ensure-official-sarif-deps.cjs --apply --commit",
    "ensure:sarif-deps:apply:cleanup": "node ./scripts/ensure-official-sarif-deps.cjs --apply --remove-local",
    "setup:mcp": "pwsh -ExecutionPolicy Bypass -File scripts/verify-serena-setup.ps1",
    "setup:mcp:bash": "bash scripts/verify-serena-setup.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@ckeditor/ckeditor5-react": "^11.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@doist/todoist-api-typescript": "^6.1.10",
    "@floating-ui/react": "^0.27.16",
    "@hookform/resolvers": "^5.2.2",
    "@langchain/core": "^1.1.4",
    "@langchain/langgraph": "^1.0.4",
    "@phosphor-icons/react": "^2.1.7",
    "@qdrant/js-client-rest": "^1.16.2",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/node": "^10.29.0",
    "@sentry/react": "^10.28.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.83.1",
    "@types/tesseract.js": "^0.0.2",
    "@upstash/redis": "^1.35.7",
    "@vercel/node": "^5.5.6",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "^4.3.7",
    "axios": "^1.7.9",
    "ckeditor5": "^47.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.6.2",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-hotkeys-hook": "^5.2.1",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.1",
    "serve": "^14.2.4",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^4.1.11",
    "tesseract.js": "^6.0.1",
    "three": "^0.172.0",
    "uuid": "^13.0.0",
    "vite": "^6.3.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ckeditor/ckeditor5-theme-lark": "^47.3.0",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/three": "^0.172.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^16.5.0",
    "jsdom": "^26.0.0",
    "lodash.throttle": "^4.1.1",
    "prettier": "^3.4.2",
    "sass-embedded": "^1.95.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.49.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "magic-string": "^0.30.0",
    "rollup": "^4.0.0",
    "eslint": "^9.17.0",
    "source-map": "^0.7.4"
  }
}
