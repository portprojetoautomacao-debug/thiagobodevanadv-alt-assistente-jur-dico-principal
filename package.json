{
  "name": "assistente-juridico-p",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "node ./scripts/start-dev.cjs",
    "kill": "fuser -k 5000/tcp",
    "build": "tsc && vite build",
    "type-check": "tsc --noEmit --skipLibCheck",
    "start": "serve -s dist -l 10000",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 eslint 'src/**/*.{ts,tsx}' 'api/**/*.ts' --ext ts,tsx --report-unused-disable-directives --max-warnings 150 --ignore-pattern 'coverage-api/**'",
    "lint:sarif": "eslint 'src/**/*.{ts,tsx}' 'api/**/*.ts' --format @microsoft/eslint-formatter-sarif --output-file eslint-results.sarif --ignore-pattern 'coverage-api/**'",
    "optimize": "vite optimize",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --config vitest.config.node.ts --coverage",
    "test:api": "vitest run --config vitest.config.node.ts",
    "test:all": "npm run test:run && npm run test:api",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:report": "playwright show-report",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "sonar:local": "node sonar-run.mjs",
    "sonar:local:old": "node sonar-scanner.mjs",
    "sonar:local:esm": "node --experimental-loader node:module ./sonar-scanner.mjs"
  },
