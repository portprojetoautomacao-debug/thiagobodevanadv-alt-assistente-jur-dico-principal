{
  "name": "assistente-juridico-p",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:with-api": "node ./scripts/start-dev-with-api.cjs",
    "dev:local": "node ./scripts/start-dev.cjs",
    "kill": "fuser -k 5000/tcp",
    "build": "tsc && vite build",
    "type-check": "tsc --noEmit --skipLibCheck",
    "start": "serve -s dist -l 10000",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 eslint 'src/**/*.{ts,tsx}' 'api/**/*.ts' --ext ts,tsx --report-unused-disable-directives --max-warnings 150 --ignore-pattern 'coverage-api/**'",
    "lint:sarif": "eslint 'src/**/*.{ts,tsx}' 'api/**/*.ts' --format @microsoft/eslint-formatter-sarif --output-file eslint-results.sarif --ignore-pattern 'coverage-api/**'",
    "optimize": "vite optimize",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --config vitest.config.node.ts --coverage",
    "test:api": "vitest run --config vitest.config.node.ts",
    "test:chrome": "cd chrome-extension-pje && npm test",
    "test:all": "npm run test:run && npm run test:api && npm run test:chrome",
    "test:integration": "vitest run tests/integration/hybrid-agents.test.ts",
    "test:integration:local-real": "vitest run --config vitest.config.node.ts api/tests/extension-errors.local-e2e.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "xvfb-run playwright test --headed",
    "test:e2e:debug": "xvfb-run playwright test --headed --debug",
    "test:e2e:ui": "xvfb-run playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:auto": "./run-e2e-tests.sh",
    "test:real-local": "bash scripts/run-local-real-tests.sh",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "sonar:local": "node sonar-run.mjs",
    "sonar:local:old": "node sonar-scanner.mjs",
    "sonar:local:esm": "node --experimental-loader node:module ./sonar-scanner.mjs",
    "setup:mcp": "pwsh -ExecutionPolicy Bypass -File scripts/verify-serena-setup.ps1",
    "setup:mcp:bash": "bash scripts/verify-serena-setup.sh",
    "qdrant:init": "tsx scripts/init-qdrant-collection.ts",
    "qdrant:test": "tsx scripts/test-qdrant-connection.ts",
    "qdrant:populate-datajud": "tsx scripts/populate-qdrant-datajud.ts",
    "daily-check": "bash scripts/daily-check.sh",
    "daily-check:win": "pwsh -ExecutionPolicy Bypass -File scripts/daily-check.ps1"
  },
