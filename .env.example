# ============================================================================
# ENVIRONMENT CONFIGURATION FOR ASSISTENTE JURÍDICO PJE
# ============================================================================
# DO NOT commit the actual .env file with real credentials to version control
# This is an example file showing the required environment variables
#
# PRODUCTION DEPLOYMENT:
# 1. Copy this file to .env
# 2. Replace placeholder values with your actual credentials
# 3. See CREDENTIALS_GUIDE.md for your specific production values
# 4. For Vercel, add these variables in the Vercel project settings
# ============================================================================

# ----------------------------------------------------------------------------
# GOOGLE OAUTH CONFIGURATION (Required for Calendar & Docs Integration)
# ----------------------------------------------------------------------------
# Google OAuth Client ID
# Get this from: https://console.cloud.google.com/apis/credentials
# Format: xxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# GitHub Spark runtime (do Vercel / runtime.config.json)
GITHUB_RUNTIME_PERMANENT_NAME=your-runtime-name-here

# Authorized Redirect URI (update for your deployment)
# Development: http://localhost:5173
# Production: https://your-app.vercel.app
VITE_REDIRECT_URI=http://localhost:5173

# Google OAuth - Client ID (frontend public, seguro para ser visível)
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# ----------------------------------------------------------------------------
# GITHUB SPARK CONFIGURATION (Required for Vercel Deployment)
# ----------------------------------------------------------------------------
# GitHub Runtime Name - get this from runtime.config.json
# This value is unique to your GitHub Spark runtime
GITHUB_RUNTIME_PERMANENT_NAME=your-runtime-name-here

# GitHub Personal Access Token (for Spark API access)
# Create a token at: https://github.com/settings/tokens
# Required scopes: repo, workflow
# Format: github_pat_XXXXXXXXXXXXXXXXXXXXXXXXXXX or ghp_XXXXXXXXXXXXXXXXXXXX
GITHUB_TOKEN=your-github-token-here

# GitHub API URL (optional, defaults to https://api.github.com)
GITHUB_API_URL=https://api.github.com

# ----------------------------------------------------------------------------
# APP ENVIRONMENT
# ----------------------------------------------------------------------------
# App Environment
# Development: development
# Production: production
VITE_APP_ENV=development

# ----------------------------------------------------------------------------
# OPTIONAL CONFIGURATIONS
# ----------------------------------------------------------------------------
# Google Gemini API Configuration (Optional - alternative to Spark LLM)
# Get your API Key from: https://aistudio.google.com/app/apikey
# Free tier available with generous limits
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# VAPID Public Key (for push notifications - if needed)
# Generate using web-push library: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# Backend URL (for production API endpoints - if using separate backend)
# Example: https://seu-backend.onrender.com
VITE_BACKEND_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# VERCEL CRON JOBS CONFIGURATION
# ----------------------------------------------------------------------------
# Tribunals to monitor for DJEN publications (comma-separated)
# Default: TST,TRT3,TJMG,TRF1,TJES,TJSP,STJ
DJEN_TRIBUNAIS=TST,TRT3,TJMG,TRF1,TJES,TJSP,STJ

# ----------------------------------------------------------------------------
# VERCEL KV CONFIGURATION (Automatically injected by Vercel)
# ----------------------------------------------------------------------------
# These are set automatically when you add Vercel KV storage to your project
# No need to manually configure these - they are provided by Vercel
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
