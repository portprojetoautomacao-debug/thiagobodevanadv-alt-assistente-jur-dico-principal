# Modelo de arquivo .env (Frontend) - Variáveis necessárias (exemplo)
# ATENÇÃO: Nunca comite o arquivo `.env` com credenciais reais no repositório.
# Use este arquivo como modelo e crie um `.env` local com valores reais quando necessário.

# Credenciais e configurações necessárias para Frontend + GitHub Spark
# Copie este arquivo para `.env` e preencha os valores sensíveis antes do deploy.

# GitHub Spark runtime (do Vercel / runtime.config.json)
GITHUB_RUNTIME_PERMANENT_NAME=97a1cb1e48835e0ecf1e

# GitHub token (token pessoal; substitua pelo token de quem tem permissão)
# Veja o guia em: OAUTH_SETUP.md ou VERCEL_DEPLOYMENT_FIX.md
GITHUB_TOKEN=ghp_your-github-token-here

# Google OAuth - Client ID (frontend public, seguro para ser visível)
VITE_GOOGLE_CLIENT_ID=572929400457-lufh2hv2dt7129mikbr1e9k5h1copv4s.apps.googleusercontent.com

# Google API Key para integrações (Calendar, Drive, Docs) - manter em segredo
VITE_GOOGLE_API_KEY=your-google-api-key-here

# DataJud API Key (API pública / requer registro) - manter em segredo
VITE_DATAJUD_API_KEY=your-datajud-api-key-here

# Ambiente da aplicação (production, development)
VITE_APP_ENV=production

# URL de redirecionamento autorizada para OAuth (Vercel após deploy)
VITE_REDIRECT_URI=https://seu-app-vercel.vercel.app

# OBS: outras variáveis podem ser necessárias (e.g. VITE_BACKEND_URL,
# VITE_VAPID_PUBLIC_KEY, GITHUB_API_URL). Verifique a documentação local
# (OAUTH_SETUP.md, VERCEL_CRON_JOBS.md, README.md) para detalhes.
