# Google OAuth Configuration
# DO NOT commit the actual .env file with real credentials to version control
# This is an example file showing the required environment variables

# Google OAuth Client ID
# Get this from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# Google API Key (for Calendar API and Docs API)
# Get this from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_API_KEY=your-api-key-here

# Authorized Redirect URI (update for your deployment)
VITE_REDIRECT_URI=http://localhost:5173

# App Environment
VITE_APP_ENV=development

# GitHub Spark Configuration (required for Vercel deployment)
# GitHub Runtime Name - get this from runtime.config.json
GITHUB_RUNTIME_PERMANENT_NAME=your-runtime-name-here

# GitHub Personal Access Token (for Spark API access)
# Create a token at: https://github.com/settings/tokens
# Required scopes: repo, workflow
GITHUB_TOKEN=ghp_your-github-token-here

# GitHub API URL (optional, defaults to https://api.github.com)
GITHUB_API_URL=https://api.github.com
