{
  "name": "Assistente Jurídico PJe",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "11"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-playwright.playwright",
        "SonarSource.sonarlint-vscode",
        "vscjava.vscode-java-pack",
        "GitHub.codespaces",
        "google.geminicodeassist"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.preferences.importModuleSpecifier": "relative",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        // Auto-provisioning (terminal & Copilot) - enable defaults in container
        "task.allowAutomaticTasks": true,
        "extensions.autoCheckUpdates": true,
        "extensions.autoUpdate": true,
        "github.copilot.enable": true,
        "github.copilot.inlineSuggest.enable": true,
        "github.copilot.chat.enable": true,
        // WARNING: Trust workspace disabled inside container for seamless automation. This lowers security in shared environments.
        "security.workspace.trust.enabled": true,
        "security.workspace.trust.untrustedFiles": "open",
        "terminal.integrated.shellIntegration.enabled": true,
        "chat.useNestedAgentsMdFiles": true,
        "chat.tools.terminal.autoReplyToPrompts": true,
        "chat.tools.terminal.autoApprove": true
      }
    }
  },
  "postCreateCommand": "npm install",
  // Rodar auto-init ao iniciar o container (de maneira não bloqueante)
  "postStartCommand": "bash auto-init.sh > /tmp/auto-init.log 2>&1 &",
  "forwardPorts": [5173, 5000],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    },
    "5000": {
      "label": "Preview Server",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "node"
}
