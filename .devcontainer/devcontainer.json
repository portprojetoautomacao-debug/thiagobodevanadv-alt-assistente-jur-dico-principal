{
  "name": "Assistente Jurídico PJe - Python",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        // Python essentials
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        // GitHub & Git
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "GitHub.codespaces",
        // Code quality
        "SonarSource.sonarlint-vscode",
        "MS-SarifVSCode.sarif-viewer",
        "trailofbits.sarif-explorer",
        // AI assistants
        "google.geminicodeassist",
        "TeamsDevApp.vscode-ai-foundry",
        "Continue.continue"
      ],
      "settings": {
        // ========================================
        // 🤖 GITHUB COPILOT - AUTOMAÇÃO MÁXIMA
        // ========================================
        "github.copilot.enable": {
          "*": true,
          "yaml": true,
          "plaintext": true,
          "markdown": true,
          "python": true,
          "json": true
        },
        "github.copilot.chat.enable": true,
        "github.copilot.chat.useInstructionFiles": true,
        "github.copilot.inlineSuggest.enable": true,
        "github.copilot.editor.enableAutoCompletions": true,
        // 🚀 FERRAMENTAS DE EDIÇÃO - Sem confirmação
        "chat.editing.enabled": true,
        "chat.editing.confirmEditRequestRemoval": false,
        "chat.extensionTools.enabled": true,
        "chat.tools.terminal.autoApprove": {
          "enabled": true
        },
        "chat.tools.terminal.autoReplyToPrompts": true,
        "github.copilot.chat.defaultToolset": "fullEditingTools",
        // 🤖 AGENTE DE CODIFICAÇÃO - Automação total
        "githubPullRequests.codingAgent.enabled": true,
        "githubPullRequests.codingAgent.autoDelegate": true,
        "githubPullRequests.codingAgent.uiIntegration": true,
        "githubPullRequests.pullRequestCardEnabled": true,
        "chat.agentSessionsViewLocation": "view",
        // ========================================
        // 🔒 SEGURANÇA E WORKSPACE TRUST
        // ========================================
        // WARNING: Trust workspace enabled for seamless automation
        "security.workspace.trust.enabled": false,
        "security.workspace.trust.untrustedFiles": "open",
        "security.workspace.trust.emptyWindow": false,
        "security.workspace.trust.startupPrompt": "never",
        // ========================================
        // 📦 GIT AUTOMÁTICO
        // ========================================
        "git.enableSmartCommit": true,
        "git.autofetch": true,
        "git.confirmSync": false,
        "git.fetchOnPull": true,
        "git.pruneOnFetch": true,
        // ========================================
        // 🛠️ TASKS E AUTOMAÇÃO
        // ========================================
        "task.allowAutomaticTasks": "on",
        "task.autoDetect": "on",
        "task.problemMatchers.neverPrompt": true,
        "task.saveBeforeRun": "always",
        // ========================================
        // ✏️ EDITOR - FORMATAÇÃO AUTOMÁTICA (PYTHON)
        // ========================================
        "editor.formatOnSave": true,
        "editor.formatOnPaste": true,
        "editor.defaultFormatter": "ms-python.black-formatter",
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        // ========================================
        // 🐍 PYTHON
        // ========================================
        "python.analysis.autoImportCompletions": true,
        "python.analysis.typeCheckingMode": "basic",
        "python.analysis.autoFormatStrings": true,
        "python.analysis.completeFunctionParens": true,
        "python.testing.pytestEnabled": true,
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.linting.ruffEnabled": true,
        "python.formatting.provider": "black",
        // ========================================
        // 🖥️ TERMINAL
        // ========================================
        "terminal.integrated.shellIntegration.enabled": true,
        "terminal.integrated.shellIntegration.decorationsEnabled": "both",
        // ========================================
        // 🧪 EXTENSÕES E ATUALIZAÇÕES
        // ========================================
        "extensions.autoCheckUpdates": true,
        "extensions.autoUpdate": true,
        "chat.useNestedAgentsMdFiles": true,
        // ========================================
        // 📊 TELEMETRIA
        // ========================================
        "telemetry.telemetryLevel": "off",
        "redhat.telemetry.enabled": false
      }
    }
  },
  "postCreateCommand": "pip install -r streamlit-app/requirements.txt && bash .vscode/trust-workspace.sh",
  // Rodar auto-init ao iniciar o container (de maneira não bloqueante)
  "postStartCommand": "bash .vscode/trust-workspace.sh",
  "forwardPorts": [
    8501,
    8000
  ],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit App",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "FastAPI Backend",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "vscode"
}
