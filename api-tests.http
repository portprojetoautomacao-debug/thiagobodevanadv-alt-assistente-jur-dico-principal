# API Tests - Assistente Jurídico PJe
# Use a extensão REST Client (humao.rest-client) para executar estes testes
# Atalhos: Ctrl+Alt+R (enviar), Ctrl+Alt+E (trocar ambiente), Ctrl+Alt+H (histórico)

### ============================================
### 🌍 AMBIENTES - Troque com Ctrl+Alt+E
### ============================================

# Variáveis compartilhadas entre todos os ambientes
# @name $shared
@apiKey = test-api-key
@version = v1
@contentType = application/json
@userAgent = vscode-restclient-assistente-juridico

# Ambiente Local (Desenvolvimento)
# @name local
@baseUrl = http://localhost:5173

# Ambiente Production (Vercel)
# @name production
@baseUrl = https://assistente-juridico-github.vercel.app

### Variáveis Auxiliares
@timestamp = {{$datetime iso8601}}

### ============================================
### 1. HEALTH CHECK - Verificar status da API
### ============================================

# @name health
GET {{baseUrl}}/api/health HTTP/1.1

###

# @name status
GET {{baseUrl}}/api/status?type=health HTTP/1.1

### ============================================
### 2. PJE SYNC - Testar sincronização da extensão
### ============================================

# @name pjeSync
POST {{baseUrl}}/api/pje-sync HTTP/1.1
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "source": "extension",
  "processos": [
    {
      "numeroProcesso": "0000000-00.2024.5.01.0000",
      "tribunal": "TRT1",
      "vara": "1ª Vara do Trabalho",
      "fase": "Conhecimento",
      "partes": "Autor vs Réu",
      "dataDistribuicao": "{{$timestamp}}",
      "status": "Em Andamento"
    }
  ],
  "expedientes": []
}

### ============================================
### 3. AGENTES - Testar sistema de agentes IA
### ============================================

# @name getAgents
GET {{baseUrl}}/api/agents HTTP/1.1

###

# @name createTask
POST {{baseUrl}}/api/agents HTTP/1.1
Content-Type: application/json

{
  "agentId": "justine",
  "action": "create-task",
  "taskType": "analyze_intimation",
  "priority": "high",
  "data": {
    "expedienteId": "test-123",
    "titulo": "Intimação Teste",
    "conteudo": "Conteúdo da intimação para análise"
  }
}

### ============================================
### 4. EXPEDIENTES - CRUD de expedientes
### ============================================

# @name getExpedientes
GET {{baseUrl}}/api/expedientes HTTP/1.1

###

# @name createExpediente
POST {{baseUrl}}/api/expedientes HTTP/1.1
Content-Type: application/json

{
  "numeroProcesso": "0000000-00.2024.5.01.0000",
  "tipo": "intimacao",
  "titulo": "Intimação via REST Client",
  "conteudo": "Conteúdo do expediente criado via REST Client",
  "dataPublicacao": "{{$timestamp}}",
  "prazo": 15,
  "urgente": false
}

###

# Capturar ID do expediente criado
@expedienteId = {{createExpediente.response.body.$.id}}

# @name getExpedienteById
GET {{baseUrl}}/api/expedientes/{{expedienteId}} HTTP/1.1

###

# @name updateExpediente
PUT {{baseUrl}}/api/expedientes/{{expedienteId}} HTTP/1.1
Content-Type: application/json

{
  "status": "analisado",
  "observacoes": "Análise concluída via REST Client"
}

###

# @name deleteExpediente
DELETE {{baseUrl}}/api/expedientes/{{expedienteId}} HTTP/1.1

### ============================================
### 5. DJEN SYNC - Monitoramento DJEN
### ============================================

# @name djenSync
POST {{baseUrl}}/api/djen-sync HTTP/1.1
Content-Type: application/json

{
  "action": "check",
  "oab": "123456",
  "tribunal": "TRT1"
}

###

# @name djenMonitor
GET {{baseUrl}}/api/cron?action=djen-monitor HTTP/1.1
Authorization: Bearer {{$processEnv CRON_SECRET}}

### ============================================
### 6. NOTIFICATIONS - Sistema de notificações
### ============================================

# @name getNotifications
GET {{baseUrl}}/api/notifications HTTP/1.1

###

# @name createNotification
POST {{baseUrl}}/api/notifications HTTP/1.1
Content-Type: application/json

{
  "type": "deadline",
  "title": "Prazo Urgente",
  "message": "Prazo de 5 dias para contestação",
  "priority": "high",
  "metadata": {
    "processoId": "test-123",
    "prazoFinal": "{{$timestamp 5 d}}"
  }
}

### ============================================
### 7. CRON JOBS - Testar jobs agendados
### ============================================

# @name cronBackup
GET {{baseUrl}}/api/cron?action=backup HTTP/1.1
Authorization: Bearer {{$processEnv CRON_SECRET}}

###

# @name cronCalendarSync
GET {{baseUrl}}/api/cron?action=calendar-sync HTTP/1.1
Authorization: Bearer {{$processEnv CRON_SECRET}}

###

# @name cronDeadlineAlerts
GET {{baseUrl}}/api/cron?action=deadline-alerts HTTP/1.1
Authorization: Bearer {{$processEnv CRON_SECRET}}

### ============================================
### 8. LLM PROXY - Testar integração Gemini
### ============================================

# @name llmStream
POST {{baseUrl}}/api/llm-stream HTTP/1.1
Content-Type: application/json

{
  "prompt": "Analise o seguinte processo e sugira próximos passos",
  "context": {
    "processo": "0000000-00.2024.5.01.0000",
    "tipo": "trabalhista"
  },
  "stream": false
}

### ============================================
### 9. OBSERVABILITY - Métricas e telemetria
### ============================================

# @name getObservability
GET {{baseUrl}}/api/observability HTTP/1.1

###

# @name postTrace
POST {{baseUrl}}/api/observability HTTP/1.1
Content-Type: application/json

{
  "type": "trace",
  "agentId": "harvey",
  "operation": "analyze_case",
  "duration": 1234,
  "success": true
}

### ============================================
### 10. GRAPHQL - Exemplo (se implementado)
### ============================================

# @name graphqlQuery
POST {{baseUrl}}/api/graphql HTTP/1.1
Content-Type: application/json
X-REQUEST-TYPE: GraphQL

query GetProcesses($limit: Int!) {
  processes(limit: $limit) {
    id
    numeroProcesso
    status
    partes
  }
}

{
  "limit": 10
}

### ============================================
### 11. TESTES DE AUTENTICAÇÃO
### ============================================

# @name login
POST {{baseUrl}}/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

###

# Capturar token da resposta
@authToken = {{login.response.body.$.token}}

# @name protectedEndpoint
GET {{baseUrl}}/api/protected HTTP/1.1
Authorization: Bearer {{authToken}}

