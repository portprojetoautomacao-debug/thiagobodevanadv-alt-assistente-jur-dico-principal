  "sonarlint.rules": {
    "typescript:S1128": {
      "level": "off"
    }
  },

  // ========================================
  // 🎯 EXPERIENCE & UI
  // ========================================

  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",

  // Terminal
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.fontSize": 13,

  // Editor
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": true,
  "editor.suggestSelection": "first",
  "editor.inlineSuggest.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,

  // IntelliSense
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "python.testing.unittestArgs": ["-v", "-s", ".", "-p", "*test.py"],
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": true,
  "chat.tools.terminal.autoReplyToPrompts": true,
  "github-actions.workflows.pinned.workflows": [".github/workflows/ci.yml"],
  "editor.codeActions.triggerOnFocusChange": true,
  "windowsaistudio.enableRemoteFine-tuningAndInference": true,

  // ========================================
  // 🔍 SONARLINT - ANÁLISE AVANÇADA
  // ========================================

  // Configurações adicionais para integração com Copilot
  "sonarlint.rules": {
    "typescript:S1854": {
      "level": "on",
      "parameters": {}
    },
    "typescript:S3776": {
      "level": "on",
      "parameters": {
        "threshold": "15"
      }
    },
    "typescript:S6957": {
      "level": "on"
    }
  },

  // Análise em tempo real
  "sonarlint.analyzeOpenFilesOnly": false,
  "sonarlint.analyzeFreshOnly": false,

  // Integração com Copilot Fix
  "sonarlint.enableCodeActionsOnSave": true,
  "sonarlint.pathToCompileCommands": "",

  // Exclusões
  "sonarlint.pathToNodeExecutable": "/usr/local/share/nvm/versions/node/v22.21.1/bin/node",
  "sonarlint.disableTelemetry": false,
  "sonarlint.trace.server": "messages",

  // ========================================
  // 🔧 GO LANGUAGE CONFIGURATION
  // ========================================
  "go.goroot": "/usr/local/go",
  "go.gopath": "/home/node/go",
  "go.toolsManagement.autoUpdate": true,
  "git.ignoreLimitWarning": true,

  // ========================================
  // 🌐 REST CLIENT - API TESTING
  // ========================================

  // Ambientes para testes (local, staging, produção)
  "rest-client.environmentVariables": {
    "$shared": {
      "apiKey": "test-api-key",
      "version": "v1"
    },
    "local": {
      "host": "localhost:5173",
      "protocol": "http",
      "baseUrl": "http://localhost:5173"
    },
    "production": {
      "host": "assistente-juridico-github.vercel.app",
      "protocol": "https",
      "baseUrl": "https://assistente-juridico-github.vercel.app"
    }
  },

  // Headers padrão
  "rest-client.defaultHeaders": {
    "User-Agent": "vscode-restclient-assistente-juridico",
    "Accept": "application/json"
  },

  // Configurações de visualização
  "rest-client.previewOption": "exchange",
  "rest-client.previewResponsePanelTakeFocus": true,
  "rest-client.showResponseInDifferentTab": false,
  "rest-client.fontSize": 13,
  "rest-client.fontFamily": "Menlo, Monaco, Consolas, 'Courier New', monospace",

  // Funcionalidades
  "rest-client.enableSendRequestCodeLens": true,
  "rest-client.enableCustomVariableReferencesCodeLens": true,
  "rest-client.rememberCookiesForSubsequentRequests": true,
  "rest-client.followredirect": true,
  "rest-client.timeoutinmilliseconds": 30000,

  // Logs e debugging
  "rest-client.logLevel": "info",
  "rest-client.enableTelemetry": false,

