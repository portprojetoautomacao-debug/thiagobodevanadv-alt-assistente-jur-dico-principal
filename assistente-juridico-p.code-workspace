{
	"folders": [
		{
			"name": "assistente-juridico-p",
			"path": "."
		}
	],
	"settings": {
		// === Git ===
		"git.autofetch": true,

		// === Editor ===
		"editor.formatOnSave": true,
		"files.autoSave": "afterDelay",
		"editor.stickyScroll.enabled": true,
		"editor.quickSuggestions": {
			"strings": true
		},

		// === GitHub Copilot ===
		"github.copilot.chat.agent.autoApprove": true,
		"github.copilot.nextEditSuggestions.enabled": true,
		"chat.agent.maxRequests": 50,
		"chat.tools.global.autoApprove": true,
		"chat.tools.terminal.autoReplyToPrompts": true,
		"chat.useNestedAgentsMdFiles": true,
		"chat.instructionsFilesLocations": {
			".github/instructions": true
		},

		// === Formatters por Linguagem ===
		"[json]": {
			"editor.defaultFormatter": "esbenp.prettier-vscode"
		},
		"[github-actions-workflow]": {
			"editor.defaultFormatter": "redhat.vscode-yaml"
		},
		"[typescriptreact]": {
			"editor.defaultFormatter": "vscode.typescript-language-features"
		},
		"[typescript]": {
			"editor.defaultFormatter": "vscode.typescript-language-features"
		},
		"[css]": {
			"editor.defaultFormatter": "vscode.css-language-features"
		},
		"[html]": {
			"editor.defaultFormatter": "vscode.html-language-features"
		},
		"[javascript]": {
			"editor.defaultFormatter": "vscode.typescript-language-features"
		},
		"[yaml]": {
			"editor.defaultFormatter": "redhat.vscode-yaml"
		},

		// === Testing ===
		"testing.alwaysRevealTestOnStateChange": true,

		// === Files ===
		"files.watcherExclude": {
			"**/docs/archive/**": true,
			"**/node_modules/**": true,
			"**/dist/**": true,
			"**/.git/objects/**": true,
			"**/.git/subtree-cache/**": true,
			"**/.vercel/**": true,
			"**/coverage/**": true,
			"**/build/**": true,
			"**/.next/**": true
		},
		"search.exclude": {
			"**/node_modules": true,
			"**/dist": true,
			"**/.git": true,
			"**/.vercel": true,
			"**/.next": true,
			"**/coverage": true
		},
		"files.associations": {
			"*.css": "tailwindcss"
		},

		// === TypeScript ===
		"typescript.tsserver.maxTsServerMemory": 2048,

		// === GitLab ===
		"gitlab.pipelineGitRemoteName": "gitlab",
		"gitlab.showPipelineUpdateNotifications": true,
		"gitlab.showStatusBarLinks": true,
		"gitlab.showIssueLinkOnStatusBar": false,
		"gitlab.showMrStatusOnStatusBar": true,
		"gitlab.debug": false,
		"gitlab.real-timeSecurityScan.enabled": true,

		// === Workbench ===
		"workbench.editor.defaultBinaryEditor": "vscode.hexEditor",

		// === Node Module Intellisense ===
		"node-module-intellisense.scanBuiltinModules": true,
		"node-module-intellisense.scanDevDependencies": true,
		"node-module-intellisense.scanFileModules": true,
		"node-module-intellisense.modulePaths": [],

		// === Tailwind CSS ===
		"tailwindCSS.includeLanguages": {
			"typescript": "javascript",
			"typescriptreact": "javascript"
		},
		"tailwindCSS.experimental.classRegex": [
			["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
			["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
			["clsx\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
		],
		"css.validate": false,

		// === SonarLint ===
		"sonarlint.connectedMode.project": {
			"connectionId": "thiagobodevan-a11y",
			"projectKey": "thiagobodevan-a11y_assistente-juridico-p"
		},
		"sonarlint.output.showVerboseLogs": true
	},
	"extensions": {
		"recommendations": [
			"github.codespaces",
			"github.vscode-github-actions",
			"github.vscode-pull-request-github",
			"github.copilot",
			"github.copilot-chat",
			"eamodio.gitlens",
			"ms-vscode.vscode-typescript-next",
			"bradlc.vscode-tailwindcss",
			"dbaeumer.vscode-eslint",
			"esbenp.prettier-vscode",
			"usernamehw.errorlens",
			"yoavbls.pretty-ts-errors",
			"redhat.vscode-yaml",
			"gitlab.gitlab-workflow",
			"sonarsource.sonarlint-vscode",
			"pkief.material-icon-theme"
		]
	}
}