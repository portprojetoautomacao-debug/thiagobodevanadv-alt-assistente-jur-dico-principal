{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2021",
    "checkJs": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["scripts/**/*.js", "*.js"],
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "**/node_modules",
    "node_modules/**/*",
    "dist",
    "**/.vite",
    "coverage",
    "coverage-api",
    "chrome-extension-pje_utils_errorHandler.js"
  ],
  "typeAcquisition": {
    "enable": true,
    "include": ["node", "vite", "react", "react-dom"]
  }
}
